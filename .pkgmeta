package-as: ForeverManaTick
manual-changelog:
  filename: RELEASE_NOTES.md
  markup-type: markdown
ignore:
  - .git
  - .github
  - .gitignore
  - .pkgmeta
  - .compiled
  - .release
  - AGENTS.md
  - VERSION
  - cmd
  - docs
  - internal
  - go.mod
  - tools
  - tests
  - "**/.DS_Store"
  - "**/__pycache__"
